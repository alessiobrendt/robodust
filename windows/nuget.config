<?xml version="1.0" encoding="utf-8"?>
<!-- RoboDust has no package dependencies. Publishing a single .exe still needs Microsoft's
     runtime packs, which come from nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
