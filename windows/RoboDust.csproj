<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>RoboDust.ico</ApplicationIcon>
    <AssemblyName>RoboDust</AssemblyName>
    <RootNamespace>RoboDust</RootNamespace>
    <Version>0.8.0</Version>
    <Product>RoboDust</Product>
    <Company>Muhammad Raufan Yusup</Company>
    <Authors>Muhammad Raufan Yusup; Windows-Version: Alessio Brendt</Authors>
    <Copyright>© 2026 Muhammad Raufan Yusup. Windows-Version entwickelt von Alessio Brendt</Copyright>
    <Description>A robot vacuum for your Windows desktop</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The meows are Elix, recorded by Joseph Sardin for BigSoundBank (CC0). -->
    <EmbeddedResource Include="../Resources/Sounds/meow-1.wav" LogicalName="RoboDust.Sounds.meow-1.wav" />
    <EmbeddedResource Include="../Resources/Sounds/meow-2.wav" LogicalName="RoboDust.Sounds.meow-2.wav" />
    <EmbeddedResource Include="../Resources/Sounds/meow-3.wav" LogicalName="RoboDust.Sounds.meow-3.wav" />
    <EmbeddedResource Include="../Resources/Sounds/meow-4.wav" LogicalName="RoboDust.Sounds.meow-4.wav" />
  </ItemGroup>

</Project>
